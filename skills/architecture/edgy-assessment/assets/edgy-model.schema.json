{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rahola/edgy-skills/skills/architecture/edgy-assessment/assets/edgy-model.schema.json",
  "title": "EDGY 23 assessment model (edgy-model.json)",
  "description": "Machine-readable output of edgy-assessment and the context object for edgy-deep-dive. Validate with tools/validate-edgy-model.py (standard library only).",
  "type": "object",
  "required": ["company", "assessed_at", "language", "elements", "core_links", "coherence", "suggested_deep_dives"],
  "properties": {
    "company": {"type": "string", "minLength": 1},
    "assessed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
    "language": {"type": "string", "enum": ["fi", "en", "fr", "de"]},
    "schema_version": {"type": "string"},
    "elements": {
      "type": "object",
      "required": ["purpose", "story", "content", "capability", "asset", "process", "task", "channel", "journey", "organisation", "product", "brand"],
      "properties": {
        "purpose": {"$ref": "#/$defs/element"},
        "story": {"$ref": "#/$defs/element"},
        "content": {"$ref": "#/$defs/element"},
        "capability": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}},
        "asset": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
        "process": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
        "task": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
        "channel": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
        "journey": {"$ref": "#/$defs/journey"},
        "organisation": {"$ref": "#/$defs/element"},
        "product": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
        "brand": {"$ref": "#/$defs/element"}
      }
    },
    "core_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": {"$ref": "#/$defs/element_type"},
          "target": {"$ref": "#/$defs/element_type"},
          "verb_en": {"type": "string"},
          "verb_fi": {"type": "string"},
          "verb_fr": {"type": "string"},
          "verb_de": {"type": "string"}
        }
      }
    },
    "coherence": {
      "type": "object",
      "required": ["organisation", "product", "brand"],
      "properties": {
        "organisation": {"$ref": "#/$defs/coherence"},
        "product": {"$ref": "#/$defs/coherence"},
        "brand": {"$ref": "#/$defs/coherence"}
      }
    },
    "suggested_deep_dives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pair", "lens", "rationale", "priority"],
        "properties": {
          "pair": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/element_type"}},
          "lens": {"type": "string", "enum": ["dependency", "alignment", "gaps", "opportunities", "all"]},
          "rationale": {"type": "string", "minLength": 1},
          "priority": {"type": "string", "enum": ["High", "Medium", "Low"]},
          "source_section": {"type": "integer", "minimum": 1, "maximum": 10}
        }
      }
    }
  },
  "$defs": {
    "element_type": {
      "type": "string",
      "enum": ["purpose", "story", "content", "capability", "asset", "process", "task", "channel", "journey", "organisation", "product", "brand"]
    },
    "element": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "id": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "capability": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "id": {"type": "string"},
        "nature": {"type": "string", "enum": ["Core", "Enabling", "Management", "Differentiating", "Commodity"]},
        "level": {"type": "string", "enum": ["Strategic", "Operational", "Foundational"]},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "journey": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "stages": {"type": "array", "items": {"type": "string"}}
      }
    },
    "coherence": {
      "type": "object",
      "required": ["alignment"],
      "properties": {
        "alignment": {"type": "string", "enum": ["Weak", "Good", "Strong"]},
        "contradictions": {"type": "array", "items": {"type": "string"}},
        "gaps": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
