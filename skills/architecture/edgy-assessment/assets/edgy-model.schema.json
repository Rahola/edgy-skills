{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rahola/edgy-skills/skills/architecture/edgy-assessment/assets/edgy-model.schema.json",
  "title": "EDGY 23 assessment model (edgy-model.json)",
  "description": "Machine-readable output of edgy-assessment and the context object for edgy-deep-dive. Validate with tools/validate-edgy-model.py (standard library only).",
  "type": "object",
  "required": ["company", "assessed_at", "language", "elements", "core_links", "coherence", "suggested_deep_dives"],
  "properties": {
    "company": {"type": "string", "minLength": 1},
    "assessed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
    "language": {"type": "string", "enum": ["fi", "en", "fr", "de"]},
    "layout": {
      "type": "object",
      "description": "Optional edgy-diagram document keys written into every generated TXT (legend, card sizing, grid, title band). Same values for all four files keep the series consistent (lint --series).",
      "properties": {
        "legend": {"type": "string", "enum": ["box", "strip"]},
        "card_width": {"type": "integer", "minimum": 60, "maximum": 600},
        "equal_cards": {"type": "boolean"},
        "group_columns": {"type": "integer", "minimum": 1, "maximum": 12},
        "cards_per_row": {"type": "integer", "minimum": 1, "maximum": 12},
        "equal_group_width": {"type": "boolean"},
        "align_groups": {"type": "string", "enum": ["grid", "none"]},
        "title": {"type": "string"},
        "footnote": {"type": "string"}
      }
    },
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+$", "description": "1.8 = the assessment model; 1.9 adds relationships[] between element ids, elements.people, organisation as an array and asset kinds; 1.10 adds journeys as an array and gaps on the realisation-trace types. A model that uses a 1.9 (1.10) structure must say 1.9 (1.10) or later — tools/validate-edgy-model.py rejects 1.9 structures in an older model, so an old writer stays an old writer."},
    "elements": {
      "type": "object",
      "required": ["purpose", "story", "content", "capability", "asset", "process", "task", "channel", "journey", "organisation", "product", "brand"],
      "properties": {
        "purpose": {"$ref": "#/$defs/element"},
        "story": {"$ref": "#/$defs/element"},
        "content": {"$ref": "#/$defs/element"},
        "capability": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}},
        "asset": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
        "process": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
        "task": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
        "channel": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
        "journey": {"description": "1.8 / 1.9: one journey; 1.10: one or several (array). Readers normalise with edgy_model_to_txt._as_list.", "oneOf": [{"$ref": "#/$defs/journey"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/journey"}}]},
        "organisation": {"description": "1.8: one organisation; 1.9: one or several (array). Readers normalise with edgy_model_to_txt._as_list.", "oneOf": [{"$ref": "#/$defs/element"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}}]},
        "people": {"type": "array", "items": {"$ref": "#/$defs/element"}, "description": "1.9: roles and personas (EDGY People) — the actors of the architecture views"},
        "product": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
        "brand": {"$ref": "#/$defs/element"}
      }
    },
    "core_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": {"$ref": "#/$defs/element_type"},
          "target": {"$ref": "#/$defs/element_type"},
          "verb_en": {"type": "string"},
          "verb_fi": {"type": "string"},
          "verb_fr": {"type": "string"},
          "verb_de": {"type": "string"}
        }
      }
    },
    "relationships": {
      "type": "array",
      "description": "1.9: relationships between elements by id — what the architecture views (application map, process maps, capability view) are derived from. Every source_id / target_id must be the id of an element of the model.",
      "items": {
        "type": "object",
        "required": ["source_id", "target_id", "verb"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "target_id": {"type": "string", "minLength": 1},
          "verb": {"type": "string", "minLength": 1, "description": "core-link, flow, tree or influence verb (skills/_shared/edgy-core-links.yaml), any of the four languages"},
          "attributes": {
            "type": "object",
            "properties": {
              "crud": {"type": "string", "pattern": "^C?R?U?D?$"},
              "data": {"type": "array", "items": {"type": "string"}},
              "technology": {"type": "string"},
              "container": {"type": "string", "description": "1.10: the id of the C4 container on the endpoint system that owns it, or two ids \"C-A; C-B\" (edgy-c4). Passed through to the TXT and the graph; the EDGY drawing and the ArchiMate export ignore it."},
              "primary": {"type": "boolean"},
              "change": {"type": "string", "enum": ["keep", "new", "change", "replace", "remove", "decide"]}
            }
          }
        }
      }
    },
    "coherence": {
      "type": "object",
      "required": ["organisation", "product", "brand"],
      "properties": {
        "organisation": {"$ref": "#/$defs/coherence"},
        "product": {"$ref": "#/$defs/coherence"},
        "brand": {"$ref": "#/$defs/coherence"}
      }
    },
    "suggested_deep_dives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pair", "lens", "rationale", "priority"],
        "properties": {
          "pair": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/element_type"}},
          "lens": {"type": "string", "enum": ["dependency", "alignment", "gaps", "opportunities", "all"]},
          "rationale": {"type": "string", "minLength": 1},
          "priority": {"type": "string", "enum": ["High", "Medium", "Low"]},
          "source_section": {"type": "integer", "minimum": 1, "maximum": 10}
        }
      }
    }
  },
  "$defs": {
    "element_type": {
      "type": "string",
      "enum": ["purpose", "story", "content", "capability", "asset", "process", "task", "channel", "journey", "organisation", "product", "brand", "people"]
    },
    "element": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "id": {"type": "string"},
        "primary": {"type": "boolean", "description": "Carries the type's core links in a triad diagram; default: the first element of the type"},
        "provenance": {"type": "string", "enum": ["confirmed", "analytical", "proposed"], "description": "confirmed = public source, analytical = this analysis's interpretation, proposed = suggestion; written as a tag into the TXT and read by edgy_semantic_review.py"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "band": {"type": "string", "enum": ["management", "core", "support"], "description": "1.9, processes: the value-chain band of an L1 process (edgy-diagram process_view: chain)"},
        "gaps": {"$ref": "#/$defs/trace_gaps"}
      }
    },
    "asset": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "id": {"type": "string"},
        "kind": {"type": "string", "description": "1.9: application | platform | integration | data; other kinds (material, document, …) are free text"},
        "hosting": {"type": "string", "enum": ["saas", "cloud", "on-prem"], "description": "1.9: where an application runs"},
        "owner": {"type": "string", "description": "1.9: id of the organisation that manages it"},
        "criticality": {"type": "string"},
        "time": {"type": "string", "enum": ["tolerate", "invest", "migrate", "eliminate"], "description": "1.9: Gartner TIME lifecycle rating (badge on the application map)"},
        "master": {"type": "boolean", "description": "1.9: kind data — master data"},
        "primary": {"type": "boolean", "description": "Carries the type's core links in a triad diagram; default: the first element of the type"},
        "provenance": {"type": "string", "enum": ["confirmed", "analytical", "proposed"]},
        "tags": {"type": "array", "items": {"type": "string"}},
        "gaps": {"$ref": "#/$defs/trace_gaps"}
      }
    },
    "capability": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "id": {"type": "string"},
        "nature": {"type": "string", "enum": ["Core", "Enabling", "Management", "Differentiating", "Commodity"]},
        "level": {"type": "string", "enum": ["Strategic", "Operational", "Foundational"]},
        "primary": {"type": "boolean", "description": "Carries the type's core links in a triad diagram; default: the first capability"},
        "provenance": {"type": "string", "enum": ["confirmed", "analytical", "proposed"]},
        "gaps": {"type": "object", "additionalProperties": false, "description": "1.9: evidence status of an empty capability-view band (W127, qa.json model_gaps[]); only confirmed_absent is a finding. 1.10 adds organisation (realisation trace, W129)", "properties": {"actors": {"$ref": "#/$defs/gap_status"}, "processes": {"$ref": "#/$defs/gap_status"}, "resources": {"$ref": "#/$defs/gap_status"}, "data": {"$ref": "#/$defs/gap_status"}, "products": {"$ref": "#/$defs/gap_status"}, "organisation": {"$ref": "#/$defs/gap_status"}}},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "journey": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "stages": {"type": "array", "items": {"type": "string"}},
        "id": {"type": "string"},
        "primary": {"type": "boolean"},
        "provenance": {"type": "string", "enum": ["confirmed", "analytical", "proposed"]},
        "tags": {"type": "array", "items": {"type": "string"}},
        "gaps": {"$ref": "#/$defs/trace_gaps"}
      }
    },
    "gap_status": {"type": "string", "enum": ["not_investigated", "out_of_scope", "unknown", "confirmed_absent"]},
    "trace_gaps": {"type": "object", "additionalProperties": false, "description": "1.10: evidence status of an empty realisation-trace band (W129, qa.json model_gaps[]). Which keys a type may use is checked by tools/validate-edgy-model.py (journey: tasks, channels, products; task: products, channels; channel: products; product: capabilities, processes, organisation; process: resources, organisation; asset and people: organisation)", "properties": {"tasks": {"$ref": "#/$defs/gap_status"}, "channels": {"$ref": "#/$defs/gap_status"}, "products": {"$ref": "#/$defs/gap_status"}, "capabilities": {"$ref": "#/$defs/gap_status"}, "processes": {"$ref": "#/$defs/gap_status"}, "resources": {"$ref": "#/$defs/gap_status"}, "actors": {"$ref": "#/$defs/gap_status"}, "data": {"$ref": "#/$defs/gap_status"}, "organisation": {"$ref": "#/$defs/gap_status"}}},
    "coherence": {
      "type": "object",
      "required": ["alignment"],
      "properties": {
        "alignment": {"type": "string", "enum": ["Weak", "Good", "Strong"]},
        "contradictions": {"type": "array", "items": {"type": "string"}},
        "gaps": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
