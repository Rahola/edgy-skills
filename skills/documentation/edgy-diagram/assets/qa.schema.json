{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "edgy-diagram qa.json manifest",
  "description": "Written by edgy_generator.py (--qa, on with --preview) next to the .drawio. The approval fields are set by a person; null means not approved.",
  "type": "object",
  "required": ["manifest_version", "generated_at", "output", "generator_warnings", "pages", "totals", "visual_approval", "semantic_approval", "delivery_notes"],
  "properties": {
    "manifest_version": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "input": {},
    "output": {"type": "string", "minLength": 1, "description": "The first delivery file that exists (relative to the manifest)"},
    "outputs": {"type": "array", "items": {"type": "string"}, "description": "Every delivery file that exists: the requested file, or one rendered file per page"},
    "preset": {},
    "generator_warnings": {"type": "array", "items": {"type": "string"}},
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "elements", "edges", "page", "lint", "visual", "layout_quality", "language_check", "text_size"],
        "properties": {
          "name": {"type": "string"},
          "map_type": {},
          "facet": {"description": "The facet of a facet layout (identity | architecture | experience | all); null for a map-type layout"},
          "language": {"type": "string", "enum": ["fi", "en", "fr", "de"]},
          "elements": {"type": "object"},
          "edges": {"type": "integer", "minimum": 0},
          "page": {"type": "object", "required": ["width", "height", "ratio"],
                   "properties": {"width": {"type": "number"}, "height": {"type": "number"}, "ratio": {"type": "number"}}},
          "lint": {"type": "object", "required": ["errors", "warnings", "rules"],
                   "properties": {"errors": {"type": "integer", "minimum": 0}, "warnings": {"type": "integer", "minimum": 0}, "rules": {"type": "object"}}},
          "visual": {"type": "integer", "minimum": 0},
          "layout_quality": {"type": "object", "required": ["ran", "findings"],
                             "properties": {"ran": {"type": "boolean"}, "findings": {"type": "integer", "minimum": 0}}},
          "language_check": {"type": "object", "required": ["findings"], "properties": {"findings": {"type": "integer", "minimum": 0}}},
          "text_size": {"type": "object", "required": ["preset", "reference_width", "scale", "findings"]},
          "image": {},
          "semantic_review": {}
        }
      }
    },
    "totals": {"type": "object", "required": ["elements", "edges", "lint_errors", "lint_warnings", "visual", "layout_quality"]},
    "semantic_review": {},
    "visual_approval": {"description": "Set by a person: \"<name or role>, YYYY-MM-DD\"; null = not approved"},
    "semantic_approval": {"description": "Set by a person: \"<name or role>, YYYY-MM-DD\"; null = not approved"},
    "delivery_notes": {}
  }
}
